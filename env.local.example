# If Paynow checkout shows "Failed to fetch" while developing: `.env.local` overrides this file.
# Remove REACT_APP_SHOP_PAYNOW_LOCAL_URL from `.env.local` if it still says http://localhost:4000
# and you want to use the Railway URL from `.env.development` instead.

# --- Supabase (required for shop orders + delivery settings) ---
REACT_APP_SUPABASE_URL=https://iaorixerxnqedwgkqxtz.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# --- EcoCash Instant Payments (Supabase Edge — preferred) ---
# Deploy:
#   npx supabase functions deploy ecocash-payment --no-verify-jwt
#   npx supabase functions deploy ecocash-notify --no-verify-jwt
# Secrets (Dashboard → Edge Functions → Secrets, or CLI):
#   npx supabase secrets set ECOCASH_API_USERNAME=ecocash
#   npx supabase secrets set ECOCASH_API_PASSWORD=mobiquity
#   npx supabase secrets set ECOCASH_MERCHANT_CODE=8003
#   npx supabase secrets set ECOCASH_MERCHANT_PIN=1234
#   npx supabase secrets set ECOCASH_MERCHANT_NUMBER=789111401
# Optional:
#   ECOCASH_MERCHANT_NAME=InGo
#   ECOCASH_CURRENCY=USD
#   ECOCASH_API_BASE=https://payonline.ecocash.co.zw/ecocashGateway-preprod/payment/v1
# Notify URL (auto if unset): https://YOUR_PROJECT.supabase.co/functions/v1/ecocash-notify
# Send your test phone numbers to the EcoCash POC for whitelist.
# Also run: supabase/shop_ecocash_payment.sql

# --- Shop Paynow payments API (Railway Node — Paynow only; EcoCash uses Supabase above) ---
REACT_APP_SHOP_PAYNOW_LOCAL_URL=https://bykea-production.up.railway.app
# Optional UI label for that gateway (default Paynow), e.g. Blue
# REACT_APP_PAYMENT_GATEWAY_DISPLAY_NAME=Blue

# --- Optional: Paynow result URL on Supabase (Paynow server callbacks after payment) ---
# Set secret PAYNOW_RESULT_URL on Supabase to your deployed paynow-result function if you use it:
#   https://iaorixerxnqedwgkqxtz.supabase.co/functions/v1/paynow-result

# --- Stripe card payments (browser publishable key only; secret key = Supabase secret STRIPE_SECRET_KEY) ---
# REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_...   # use pk_live_... in .env.production
# Deploy: npx supabase functions deploy stripe-payment --no-verify-jwt
# Secrets (Dashboard → Edge Functions → Secrets, or CLI):
#   npx supabase secrets set STRIPE_SECRET_KEY=sk_live_...   # must match pk_live_ / pk_test_
#   npx supabase secrets set STRIPE_PUBLIC_SITE_URL=https://ingo-92d5f.web.app
#     (optional if using default Firebase Hosting; required for a custom domain)
#     Comma-separated origins OK. Also accepts PUBLIC_APP_URL.

# --- Google Maps (see root .env.example for API enablement) ---
REACT_APP_GOOGLE_MAPS_API_KEY=
# Optional: home map uses iframe embed only (no Maps JS). Omit for default: Maps JS + Google’s pin when key is set.
# REACT_APP_HOME_USE_MAPS_EMBED_ONLY=true

# --- Customer email verification (Resend; Edge function `customer-email-verify`) ---
# Set these as Supabase secrets (Dashboard → Edge Functions → Secrets), not in React:
#   RESEND_API_KEY=re_...
#   EMAIL_VERIFY_HMAC_SECRET=<long random string>
# Optional:
#   RESEND_FROM_EMAIL=InGo <admin@ingo.co.zw>
# Deploy: supabase functions deploy customer-email-verify --no-verify-jwt
# SQL: run supabase/app_users_email_verification.sql once (marks existing accounts verified)

# --- Password reset (same Resend + HMAC; Edge function `password-reset`) ---
# Uses EMAIL_VERIFY_HMAC_SECRET (or set PASSWORD_RESET_HMAC_SECRET separately on the function).
# Deploy: supabase functions deploy password-reset --no-verify-jwt
# SQL: run supabase/password_reset_support.sql once on the database

# --- Shop order placed (Resend; Edge `shop-order-placed-notify`) ---
# Emails the customer (if they entered an email) and each shop owner when a shop checkout is saved.
# Same RESEND_API_KEY / RESEND_FROM_EMAIL as above.
# Deploy: supabase functions deploy shop-order-placed-notify --no-verify-jwt

# --- Shop order picked up (Resend; Edge `shop-order-picked-up-notify`) ---
# Emails the customer when a driver marks a /shop/checkout order as picked up.
# Deploy: supabase functions deploy shop-order-picked-up-notify --no-verify-jwt
# Optional on function: PUBLIC_APP_URL for track link in email

# --- Driver offer push / closed-app ring (FCM Web Push; Edge `driver-offer-push`) ---
# Drivers tap “Allow notifications & ring” while online → FCM token saved.
# When a ride/booking is offered, edge sends a system notification even if the app is closed.
# Firebase Console → Cloud Messaging → Web Push certificates → copy key pair:
# Web only (.env.local / .env.production). Do NOT add this to Supabase secrets.
REACT_APP_FIREBASE_VAPID_KEY=
# SQL: run supabase/driver_push_tokens.sql once
# Deploy: supabase functions deploy driver-offer-push --no-verify-jwt
# Secrets (Dashboard → Edge Functions → Secrets), pick one:
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   (preferred)
#   OR FCM_SERVER_KEY=...
# Optional: PUBLIC_APP_URL=https://your-hosted-app-url
