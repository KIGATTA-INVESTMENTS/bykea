# Copy to .env.local (gitignored) to point a LOCAL build at a throwaway Supabase
# project instead of the client's production one. See docs/push-local-testing.md.
#
# Without this file, the app falls back to the PRODUCTION Supabase hardcoded in
# src/lib/supabaseClient.js — a test registration then creates a real user.
#
# CRA reads .env.local at build time: change it, then `npm run build` again.

# From Supabase → Project Settings → API
REACT_APP_SUPABASE_URL=https://<your-ref>.supabase.co
REACT_APP_SUPABASE_ANON_KEY=<anon key>

# Optional. Leave unset to keep Paynow pointed at the client's Railway API,
# which is fine for push testing (no payment is made).
# REACT_APP_SHOP_PAYNOW_LOCAL_URL=http://localhost:4000

# Google Maps. Unset means map pages render degraded, which does not affect push.
# REACT_APP_GOOGLE_MAPS_API_KEY=
